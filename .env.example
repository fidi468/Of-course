# Supabase layihə məlumatları (bu fayl nümunədir — real dəyərləri .env faylında saxlayın)
# .env faylı .gitignore-a daxildir və repoya commit olunmur.
# Alınma yer: Supabase Dashboard → Project Settings → API

# Layihə URL-i (məsələn: https://zahacxbgfvvljaapapmw.supabase.co)
VITE_SUPABASE_URL=

# Anonim / publishable açar (frontend üçün təhlükəsizdir, xəfiyi açar DEYİL)
VITE_SUPABASE_PUBLISHABLE_KEY=
